rules_version = '2';
// Règles de sécurité de « Paso a paso ».
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isAdmin() {
      return signedIn() && exists(userDoc()) && get(userDoc()).data.role == 'admin';
    }
    function isTeacherEmail() {
      return signedIn() && request.auth.token.email == 'smeersjf@gmail.com';
    }
    function activeStudent() {
      return signedIn() && exists(userDoc()) && get(userDoc()).data.get('disabled', false) != true;
    }

    // Profils : le prof crée les élèves ; chacun lit son profil ;
    // un élève peut modifier son prénom, jamais son rôle ni son statut.
    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create: if (signedIn() && me() == uid && isTeacherEmail() && request.resource.data.role == 'admin')
                    || isAdmin();
      allow update: if isAdmin()
                    || (signedIn() && me() == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false));
      allow delete: if isAdmin();
    }

    // Leçons : lisibles par les élèves connectés, modifiables par le prof seul.
    match /lessons/{id} {
      allow read: if activeStudent() || isAdmin();
      allow write: if isAdmin();
    }

    // Parcours personnalisé de chaque élève : écrit par le prof uniquement.
    match /plans/{uid} {
      allow read: if (signedIn() && me() == uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Progression (scores, révisions) : écrite par l'élève lui-même.
    match /progress/{uid} {
      allow read: if (signedIn() && me() == uid) || isAdmin();
      allow write: if (signedIn() && me() == uid) || isAdmin();
    }

    // Bibliothèque : un élève ne voit QUE les dossiers et fichiers qui lui sont attribués.
    match /folders/{id} {
      allow read: if isAdmin() || (activeStudent() && me() in resource.data.students);
      allow write: if isAdmin();
    }
    match /files/{id} {
      allow read: if isAdmin() || (activeStudent() && me() in resource.data.students);
      allow write: if isAdmin();
      match /chunks/{n} {
        allow read: if isAdmin()
                    || (activeStudent() && me() in get(/databases/$(database)/documents/files/$(id)).data.students);
        allow write: if isAdmin();
      }
    }

    // Messagerie : un fil par élève. L'élève n'écrit que ses propres messages, ne modifie ni ne supprime rien.
    match /threads/{uid} {
      allow read: if (signedIn() && me() == uid) || isAdmin();
      allow create, update: if (activeStudent() && me() == uid) || isAdmin();
      allow delete: if isAdmin();
      match /msgs/{id} {
        allow read: if (signedIn() && me() == uid) || isAdmin();
        allow create: if isAdmin()
                      || (activeStudent() && me() == uid && request.resource.data.f == 's'
                          && request.resource.data.t is string && request.resource.data.t.size() <= 4000);
        allow update, delete: if isAdmin();
      }
    }

    // Rédactions : l'élève écrit et envoie ; seule la professeure corrige.
    match /writings/{uid}/items/{id} {
      allow read: if (signedIn() && me() == uid) || isAdmin();
      allow create: if isAdmin()
                    || (activeStudent() && me() == uid
                        && request.resource.data.status in ['draft', 'sent']
                        && !request.resource.data.keys().hasAny(['corr', 'comment', 'grade', 'doneAt']));
      allow update: if isAdmin()
                    || (activeStudent() && me() == uid && (
                         (resource.data.status in ['todo', 'draft']
                          && request.resource.data.status in ['draft', 'sent']
                          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['corr', 'comment', 'grade', 'doneAt', 'prompt']))
                      || (resource.data.status == 'done'
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenS']))));
      allow delete: if isAdmin() || (signedIn() && me() == uid && resource.data.status == 'draft');
    }

    // Parcours types et réglages : réservés au prof (réglages lisibles par tous).
    match /templates/{id} {
      allow read, write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn() || id == 'privacy';   // la politique de confidentialité est lisible avant connexion
      allow write: if isAdmin();
    }
  }
}
